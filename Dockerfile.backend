# .NET 8 on Debian Bookworm. APM native profiler comes from K8s Single Step Instrumentation, not the image.
FROM mcr.microsoft.com/dotnet/aspnet:8.0-bookworm-slim AS base
WORKDIR /app
EXPOSE 80

RUN mkdir -p /app/logs && chmod -R 777 /app/logs

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY StockPriceApi.csproj ./
RUN dotnet restore "StockPriceApi.csproj"
COPY . .
RUN dotnet build "StockPriceApi.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "StockPriceApi.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh
COPY --from=publish /app/publish .
RUN mkdir -p /var/log/datadog/dotnet && chmod a+rwx /var/log/datadog/dotnet

ENTRYPOINT ["/app/docker-entrypoint.sh"]
