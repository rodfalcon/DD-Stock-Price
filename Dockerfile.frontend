# Stage 1: Build the React application (Node 20 LTS)
FROM node:20-bookworm-slim AS build

WORKDIR /app

COPY stock-price-frontend/package*.json ./

RUN npm install
RUN npm install @datadog/browser-rum
RUN npm i @datadog/browser-logs

COPY stock-price-frontend/ .

ARG REACT_APP_BACKEND_URL=
ARG REACT_APP_DD_APPLICATION_ID=c3760513-419d-430d-8555-39e8e332d818
ARG REACT_APP_DD_CLIENT_TOKEN=pubb32205f55611319be86fad6ef509e301
ARG REACT_APP_DD_SITE=datadoghq.com
ARG REACT_APP_DD_ENV=dev
ARG REACT_APP_DD_VERSION=1.0.0

ENV REACT_APP_BACKEND_URL=$REACT_APP_BACKEND_URL
ENV REACT_APP_DD_APPLICATION_ID=$REACT_APP_DD_APPLICATION_ID
ENV REACT_APP_DD_CLIENT_TOKEN=$REACT_APP_DD_CLIENT_TOKEN
ENV REACT_APP_DD_SITE=$REACT_APP_DD_SITE
ENV REACT_APP_DD_ENV=$REACT_APP_DD_ENV
ENV REACT_APP_DD_VERSION=$REACT_APP_DD_VERSION

RUN npm run build

# Stage 2: Serve the React application using Nginx
FROM nginx:alpine

ARG API_UPSTREAM=stockprice-backend-service:80

COPY --from=build /app/build /usr/share/nginx/html
COPY stock-price-frontend/nginx.default.conf /tmp/nginx.default.conf
RUN sed "s|__API_UPSTREAM__|${API_UPSTREAM}|g" /tmp/nginx.default.conf > /etc/nginx/conf.d/default.conf \
  && rm /tmp/nginx.default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
